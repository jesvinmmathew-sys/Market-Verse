# SERVER ONLY: never use a VITE_ or NEXT_PUBLIC_ prefix for provider secrets.
GEMINI_API_KEY=
MARKET_API_KEY=
# Optional server-side Gemini model selection.
GEMINI_MODEL=gemini-2.5-flash

# PUBLIC browser configuration: use your own Supabase project.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_publishable_key_here

# Server Auth verification uses the same project and a publishable/legacy anon key.
# Existing SUPABASE_URL / SUPABASE_ANON_KEY deployments remain supported.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_publishable_key_here
# Never put a service-role or secret key in either public-key setting.

# Node must support fetch and AbortSignal.timeout/any (Node 22+ recommended).
